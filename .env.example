# Environment Variables Example
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# API Configuration
# Add your API keys here when needed
# API_KEY=your_api_key_here

# Database Configuration (for future use)
# DATABASE_URL=your_database_connection_string
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password

# Vercel Environment Variables
# These should be set in the Vercel dashboard:
# - Production: Set in Project Settings > Environment Variables
# - Preview: Optional preview-specific variables
# - Development: Use .env file locally
